# Citera backend — copy this file to `.env` and fill in the values.
# (kept without the leading dot so tooling does not treat it as a live secret file)

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:4200
API_URL=http://localhost:3000

# --- database (matches docker-compose.yml) ---
# If your host already runs something on 5432, start compose with POSTGRES_PORT=5433 and change
# the port here to match (`docker compose up -d postgres` picks the host port from that var).
DATABASE_URL="postgresql://citera:citera@localhost:5432/citera?schema=public"

# --- queues ---
REDIS_URL="redis://localhost:6379"

# --- auth ---
# TTLs are in seconds and are the single source of truth for both the JWT `exp` and the
# persisted refresh-session expiry. 900 = 15m, 2592000 = 30d.
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL_SECONDS=2592000

# --- object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="citera"
S3_ACCESS_KEY="citera"
S3_SECRET_KEY="citera-dev-secret"
S3_PUBLIC_BASE_URL="http://localhost:9000/citera"

# --- AI providers (only the ones we actually enable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# --- SEO / analytics data ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/integrations/google/callback"
PAGESPEED_API_KEY=
AHREFS_API_TOKEN=

# --- publishing connector ---
WORDPRESS_CONNECTOR_TIMEOUT_MS=30000
